# Postgres database. Use the pooled Neon URL for the app runtime.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Optional direct/unpooled Neon URL for one-off migration/import scripts.
DATABASE_URL_UNPOOLED=
DATABASE_DRIVER=postgres-js

# API key for protected RSS/career fetch endpoints.
API_KEY=your-secret-api-key

# Site URL.
SITE_URL=http://localhost:3000

# Optional comma-separated browser origins for the Figma import endpoint.
FIGMA_IMPORT_ALLOWED_ORIGINS=
TRUST_X_FORWARDED_FOR=false

# Revalidation token.
REVALIDATE_SECRET=your-revalidate-secret

# Local RSS scheduler.
ENABLE_LOCAL_RSS_SCHEDULER=false
LOCAL_RSS_INTERVAL_MINUTES=60

# Local career content scheduler.
CAREER_FETCH_INTERVAL_MINUTES=10

# RSSHub configuration.
RSSHUB_BASE_URL=
XIAOHONGSHU_COOKIE=

# DeepSeek model configuration.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
